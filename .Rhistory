gm<-gapminder
View(gm)
gm2<-gm%>%
mutate(log_GDPperCap=log(gdpPercap))%>%
group_by(country)%>%
mutate(lifeExp_within=lifeExp-mean(lifeExp),
log_GDPperCap_Within=log_GDPperCap-
mean(log_GDPperCap))%>%
ungroup()
View(gm2)
lm(lifeExp_within~log_GDPperCap,data=gm2)
msummary(m1,stars = c('',=.1,'**'=.05,'***'=.01))
msummary(m1,stars = c('*',=.1,'**'=.05,'***'=.01))
msummary(m1,stars = c('*'=.1,'**'=.05,'***'=.01))
m1<-lm(lifeExp_within~log_GDPperCap,data=gm2)
msummary(m1,stars = c('*'=.1,'**'=.05,'***'=.01))
gm2<-gm%>%
mutate(log_GDPperCap=log(gdpPercap))%>%
group_by(country)%>%
mutate(lifeExp_within=lifeExp-mean(lifeExp),
log_GDPperCap_Within=log_GDPperCap-mean(log_GDPperCap))%>%
ungroup()
m1<-lm(lifeExp_within~log_GDPperCap,data=gm2)
msummary(m1,stars = c('*'=.1,'**'=.05,'***'=.01))
m1<-lm(lifeExp_within~log_GDPperCap_Within,data=gm2)
msummary(m1,stars = c('*'=.1,'**'=.05,'***'=.01))
colnames(gm)
m2<-lm(lifeExp~factor(country)+log(gdpPercap),data = gm)
msummary(m2,stars = c('*'=.1,'**'=.05,'***'=.01))
